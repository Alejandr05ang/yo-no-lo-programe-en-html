APP_ENV=development
# Comma-separated list of exact origins (no trailing slash, no path). One per
# frontend deployment that must be allowed to call this API (e.g. Firebase
# Hosting and a Netlify site at once).
APP_ORIGIN=http://localhost:5173

# Server-only PostgreSQL URL from Supabase Connect. Never use VITE_* here.
# Paste a PostgreSQL URL without query parameters. TLS is always certificate-verified.
DATABASE_URL=
# Optional absolute path to a trusted root CA PEM if required by the database certificate.
DATABASE_SSL_CA_FILE=

# Dedicated Firebase project; real value documented in docs/FIREBASE-SETUP.md.
FIREBASE_PROJECT_ID=
# Absolute path outside this repository, or leave empty for Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=

# Reserved for the next avatar phase; not used by current authentication endpoints.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

MAX_REQUEST_BYTES=6291456
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_MAX_CLIENTS=10000

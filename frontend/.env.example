# Copiar a .env (dev) o definir en las variables de entorno de Netlify (prod).

# URL del backend FastAPI. Sin definir usa /api.
# VITE_API_URL=http://localhost:8000

# Base de donde salen los MP3 de la música de fondo. DEBE terminar en "/".
# Sin definir usa /music/ (frontend/public/music, solo para desarrollo).
# Ejemplos (ver frontend/public/music/README.md):
#   VITE_MUSICA_URL=https://cdn.jsdelivr.net/gh/tu-usuario/taller-musica@main/
#   VITE_MUSICA_URL=https://taller-musica.netlify.app/
# VITE_MUSICA_URL=

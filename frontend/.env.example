# Copiar a .env.local (ignorado por git). Son variables públicas del navegador.
# Nunca incluir DATABASE_URL, claves de Supabase ni credenciales de Firebase Admin.

# Origen de FastAPI. /api se añade automáticamente. Sin definir usa el mismo origen.
# HTTP se permite solo en localhost/127.0.0.1 durante desarrollo; producción requiere HTTPS.
VITE_API_URL=http://localhost:8000

# Firebase Console > Configuración del proyecto > Tus apps > Aplicación web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Solo desarrollo: activa explícitamente los ejercicios/mocks locales de FASE A.
# Se ignora en builds de producción; no es un modo demo de cuentas reales.
VITE_ENABLE_LOCAL_EXERCISES=false

# Base de donde salen los MP3 de la música de fondo. DEBE terminar en "/".
# Sin definir usa /music/ (frontend/public/music, solo para desarrollo).
# Ejemplos (ver frontend/public/music/README.md):
#   VITE_MUSICA_URL=https://cdn.jsdelivr.net/gh/tu-usuario/taller-musica@main/
#   VITE_MUSICA_URL=https://taller-musica.netlify.app/
# VITE_MUSICA_URL=
